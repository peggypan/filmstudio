# ============================================
# FilmStudio API 环境变量配置
# ============================================

# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置 (PostgreSQL)
# 格式: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filmstudio?schema=public"

# JWT 认证配置
# 建议: 使用随机生成的长字符串，最少 32 个字符
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
# Token 过期时间（分钟）
JWT_EXPIRATION=15
JWT_REFRESH_EXPIRATION=10080

# 文件上传配置
# 上传文件大小限制（MB）
MAX_FILE_SIZE=50
# 上传目录（相对于项目根目录）
UPLOAD_DIR="uploads"

# ============================================
# AI 服务 API 密钥（可选，用于 AI 功能）
# ============================================

# OpenAI API - 用于剧本生成
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# OpenAI 模型选择
OPENAI_MODEL="gpt-4"

# ElevenLabs API - 用于配音合成
# 获取地址: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""

# ============================================
# CORS 配置
# ============================================

# 允许的前端域名（多个用逗号分隔）
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# ============================================
# 日志配置
# ============================================

# 日志级别: error, warn, log, verbose, debug
LOG_LEVEL="log"
